DATABASE_URL="postgres://user:password@localhost:5432/shliff"
AUTH_SECRET="generate-with-openssl-rand-base64-32"
BLOB_READ_WRITE_TOKEN=""
STORAGE_DRIVER="local"
LOCAL_STORAGE_DIR="./.uploads"

# Not read by the running app — only by `scripts/create-admin.ts`, and only
# for that one invocation:
#   ADMIN_PASSWORD="..." npx tsx scripts/create-admin.ts <email>
# Never pass the password as a command-line argument; it would end up in
# shell history and process listings.
ADMIN_PASSWORD=""
